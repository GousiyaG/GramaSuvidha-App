<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 🔝 HEADER (CLEAN) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#FF7A00"
            android:gravity="center"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GramaSuvidha"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- MAIN CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome to GramaSuvidha"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="20dp"/>

            <!-- Projects Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="20dp"
                android:layout_marginBottom="15dp"
                android:elevation="5dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Village Projects"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Check development works in your village"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="10dp"/>

                <Button
                    android:id="@+id/viewProjectsBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View Projects"
                    android:backgroundTint="#6A5ACD"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <!-- Feedback Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="20dp"
                android:elevation="5dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Feedback"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Share your opinion or report issues"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="10dp"/>

                <Button
                    android:id="@+id/feedbackBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Give Feedback"
                    android:backgroundTint="#FF7043"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <!-- Quote Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="30dp"
                android:padding="20dp"
                android:background="#E8EAF6"
                android:gravity="center"
                android:elevation="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="“Small steps today, big changes tomorrow.”"
                    android:textSize="16sp"
                    android:textStyle="italic"
                    android:textColor="#333333"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="- Empowering Rural India"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginTop="5dp"/>
                <Button
                    android:id="@+id/viewFeedbackListBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View Feedback"
                    android:backgroundTint="#26A69A"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="10dp"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>